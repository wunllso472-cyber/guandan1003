{
  "name": "guandan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:client": "tsc --noEmit && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/server.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "undici": "^8.11.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
